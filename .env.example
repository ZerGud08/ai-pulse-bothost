# Application
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=True

# Schedule
SCOUT_INTERVAL_HOURS=2
DAILY_DIGEST_HOUR=9
WEEKLY_ANALYTICS_DAY=fri
WEEKLY_ANALYTICS_HOUR=18

# Content
MIN_SCORE_FOR_PUBLICATION=60
MAX_POSTS_PER_DAY=5
LANGUAGE=ru